static func get_skill(id: String) -> Dictionary:
	skills()
	return _skill_by_id.get(id, {})


static func get_discipline(id: String) -> Dictionary:
	for dd in disciplines():
		if dd.id == id:
			return dd
	return {}


static func skills_of(id: String) -> Array:
	var out: Array = []
	for s in skills():
		if s.discipline == id:
			out.append(s)
	return out


## a / b are discipline ids or "" for an empty slot.
static func combo_title(a, b) -> String:
	var sa: String = a if a is String else ""
	var sb: String = b if b is String else ""
	if sa != "" and sb != "":
		var pair := [sa, sb]
		pair.sort()
		return COMBOS.get(pair[0] + "+" + pair[1], "Wanderer")
	var one := sa if sa != "" else sb
	if one != "":
		return get_discipline(one).name
	return "Wanderer"
