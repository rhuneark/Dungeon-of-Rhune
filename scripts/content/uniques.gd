static func get_unique(id: String) -> Dictionary:
	all()
	return _by_id.get(id, {})


static func for_base(base_id: String, ilvl: int) -> Array:
	var out: Array = []
	for u in all():
		if u.baseId == base_id and u.qlvl <= ilvl:
			out.append(u)
	return out
