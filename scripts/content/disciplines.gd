class_name Disciplines
## Skill system model (a homage blend):
##  - Grim Dawn: pick up to TWO Disciplines. Path Points raise a Discipline's
##    rank; each rank grants passive stats and rank thresholds unlock skills.
##    Every pair has a combo title.
##  - Last Epoch: each skill has its OWN specialization tree. Specialize up to
##    5 skills; specialized skills gain XP as you do and every skill level is
##    one tree point. Items with +skills add points too.
## Tree node `effects` are {key, perRank} pairs the combat layer reads later;
## keys prefixed with 'stat:' are plain hero stats and apply right now.
##
## Discipline: {id, name, tagline, color, perRank: [{stat, value}], maxRank, lore}
## Skill: {id, name, discipline, unlockRank, kind, damageType ("" none), tags,
##         description, baseInfo, passivePerLevel ([] none), tree: [node]}
## Node: {id, name, maxRank, col, row, requires ({} none | {node, points}), text, effects}

const DISCIPLINE_IDS := ["bulwark", "emberwright", "galeborn", "hollowcaller"]
## [tier 1 name, tier 2 name] for the "+N to <Discipline> Skills" prefix.
const DISCIPLINE_AFFIX_NAMES := {
	"bulwark": ["Ironclad", "Unbreaking"],
	"emberwright": ["Forgeborn", "Kilnheart"],
	"galeborn": ["Stormtouched", "Tempest-Born"],
	"hollowcaller": ["Gravebound", "Hollow-Sworn"],
