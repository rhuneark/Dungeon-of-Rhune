{
    "name": "dungeon-of-rhune",
    "productName": "Dungeon of Rhune",
    "version": "0.1.0",
    "description": "A pixel-art ARPG homage: D2 loot, Grim Dawn dual masteries, Last Epoch skill trees, rhunes, and a goose.",
    "author": "rhuneark",
    "private": true,
    "type": "module",
    "main": "desktop/main.cjs",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "desktop": "npm run build && electron .",
        "desktop:dev": "node desktop/dev.mjs",
        "dist": "npm run build && electron-builder --dir",
        "dist:win": "npm run build && electron-builder --win --x64 --dir",
        "dist:linux": "npm run build && electron-builder --linux --x64 --dir",
        "dist:mac": "npm run build && electron-builder --mac --universal --dir"
    },
    "keywords": [
        "arpg",
        "pixel-art",
        "loot",
        "pixi",
        "react",
        "electron",
        "steam"
    ],
    "license": "SEE LICENSE IN LICENSE.txt",
    "allowScripts": {
        "electron": true,
        "esbuild": true,
        "fsevents": true
    },
    "optionalDependencies": {
        "steamworks.js": "^0.4.0"
    },
    "devDependencies": {
        "@fontsource/jacquarda-bastarda-9": "^5.3.0",
        "@fontsource/jersey-10": "^5.3.0",
        "@fontsource/silkscreen": "^5.3.0",
        "@tailwindcss/vite": "^4.1.5",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.4.1",
        "electron": "^45.2.3",
        "electron-builder": "^26.18.0",
        "pixi.js": "^8.18.1",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "tailwindcss": "^4.1.5",
        "typescript": "^5.8.0",
        "vite": "^6.3.5"
    }
}
