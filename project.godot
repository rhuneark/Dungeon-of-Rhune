; Dungeon of Rhune — Godot 4 project.
; Pixel-perfect settings: nearest filtering and 2D pixel snapping. The game
; renders at native resolution; View (scripts/autoload/view.gd) zooms the world
; camera by an integer and scales the UI CanvasLayer (integer, or 1.5x on
; mid-size windows), so art pixels always cover whole device pixels.

config_version=5

[application]

config/name="Dungeon of Rhune"
config/description="A pixel-art ARPG: hunt loot, speak Rhunewords, and leave the goose alone."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Dungeon of Rhune"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0509804, 0.0431373, 0.0352941, 1)
boot_splash/show_image=false
config/icon="res://assets/icon.png"

[audio]

driver/enable_input=false

[autoload]

View="*res://scripts/autoload/view.gd"
Platform="*res://scripts/autoload/platform.gd"
Art="*res://scripts/autoload/art.gd"
Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/min_width=960
window/size/min_height=600
window/vsync/vsync_mode=1

[editor]

movie_writer/fps=30

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0
common/snap_controls_to_pixels=true

